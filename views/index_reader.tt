<header class="reader-top">
  <h1>Calibre Library</h1>
  <p><a href="[% view_switch_url %]">Switch to normal view</a></p>
</header>

<form class="reader-search" method="get" action="/search">
  <label for="search-query">Search books and authors</label>
  <input id="search-query" type="search" name="q" value="" placeholder="Title, author, tag, series">
  <input type="hidden" name="view" value="reader">
  <button type="submit">Search</button>
</form>

<section class="reader-section">
  <h2>Recent Books</h2>
[% IF recent_books.size %]
  [% FOREACH book IN recent_books %]
    [% INCLUDE reader_book.tt book=book %]
  [% END %]
[% ELSE %]
  <p class="reader-muted">No recent books are available.</p>
[% END %]
</section>

<section class="reader-section">
  <h2>Library</h2>
[% IF books.size %]
  <p class="reader-muted">Page [% page %]</p>
  [% FOREACH book IN books %]
    [% INCLUDE reader_book.tt book=book %]
  [% END %]
[% IF has_prev || has_next %]
  <nav class="reader-pages" aria-label="Library pages">
    [% IF has_prev %]
       <a class="reader-page-link" href="/?page=[% page - 1 %]&view=reader">Previous page</a>
    [% ELSE %]
      <span class="reader-page-note">At the first page</span>
    [% END %]
    [% IF has_next %]
       <a class="reader-page-link" href="/?page=[% page + 1 %]&view=reader">Next page</a>
    [% ELSE %]
      <span class="reader-page-note">No more pages</span>
    [% END %]
  </nav>
[% END %]
[% ELSE %]
  <p class="reader-muted">No books are available.</p>
[% END %]
</section>
